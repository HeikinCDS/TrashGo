<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TrashGo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/trashgo_primary</item>
        <item name="colorOnPrimary">@color/trashgo_on_primary</item>
        <item name="colorPrimaryContainer">@color/trashgo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/trashgo_on_primary_container</item>
        <item name="colorSecondary">@color/trashgo_secondary</item>
        <item name="android:colorBackground">@color/trashgo_background</item>
        <item name="colorSurface">@color/trashgo_surface</item>
        <item name="colorOnSurface">@color/trashgo_on_surface</item>
        <item name="colorOutline">@color/trashgo_outline</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TextAppearance.TrashGo.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/trashgo_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TrashGo.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/trashgo_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TrashGo.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/trashgo_on_surface</item>
    </style>

    <style name="Widget.TrashGo.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/trashgo_primary</item>
        <item name="android:textColor">@color/trashgo_on_primary</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.TrashGo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/trashgo_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
    </style>

</resources>
