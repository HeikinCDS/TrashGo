<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trashgo_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="40dp">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_logo_mark"
            android:contentDescription="@string/app_logo"
            android:alpha="0"
            tools:alpha="1" />

        <TextView
            android:id="@+id/splash_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/app_name"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03"
            android:textColor="@color/trashgo_primary_deep"
            android:alpha="0"
            tools:alpha="1" />

        <TextView
            android:id="@+id/splash_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_slogan"
            android:textSize="16sp"
            android:letterSpacing="0.02"
            android:textColor="@color/trashgo_on_surface_variant"
            android:alpha="0"
            tools:alpha="1" />

    </LinearLayout>

</FrameLayout>
