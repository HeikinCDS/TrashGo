<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top"
    android:paddingHorizontal="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="26dp"
        android:background="@color/trashgo_divider_strong" />

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal">

        <View
            android:id="@+id/claim_ring"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_badge_ring" />

        <FrameLayout
            android:id="@+id/claim_badge"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_badge_success">

            <ImageView
                android:id="@+id/claim_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="@color/trashgo_primary" />

        </FrameLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/claim_headline"
        style="@style/TextAppearance.TrashGo.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:alpha="0"
        android:gravity="center"
        tools:text="+25 points" />

    <TextView
        android:id="@+id/claim_detail"
        style="@style/TextAppearance.TrashGo.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0"
        android:gravity="center"
        tools:text="E-waste · 3 day streak" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/claim_done"
        style="@style/Widget.TrashGo.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/claim_done" />

</LinearLayout>
