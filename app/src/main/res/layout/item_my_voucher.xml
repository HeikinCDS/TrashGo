<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/trashgo_divider"
    app:cardBackgroundColor="@color/trashgo_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/my_voucher_title"
                style="@style/TextAppearance.TrashGo.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                tools:text="☕️ $5 Eco Coffee Voucher" />

            <TextView
                android:id="@+id/my_voucher_date"
                style="@style/TextAppearance.TrashGo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2026-09-04" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/my_voucher_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/trashgo_primary_container_soft"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/trashgo_primary"
                tools:text="CODE: COFFEE5-8912" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_voucher_code"
                style="@style/Widget.TrashGo.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Copy Code" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
