<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trashgo_camera_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/qr_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/btn_qr_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:padding="10dp"
        android:background="@drawable/bg_scan_close"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/close"
        app:tint="@color/trashgo_on_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="top"
        android:layout_marginTop="80dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/qr_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/trashgo_on_primary"
            android:gravity="center"
            tools:text="Scan Station QR Code" />

        <TextView
            android:id="@+id/qr_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="#CCFFFFFF"
            android:gravity="center"
            android:text="@string/qr_simulation_hint" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_qr_scan_frame"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_qr_scan"
            style="@style/Widget.TrashGo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Station QR Code Scan" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/qr_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="@color/trashgo_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Verifying Station &amp; Distributing Points..."
                android:textColor="@color/trashgo_on_primary"
                android:textSize="15sp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
