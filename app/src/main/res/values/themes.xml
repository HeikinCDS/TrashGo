<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TrashGo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/trashgo_primary</item>
        <item name="colorOnPrimary">@color/trashgo_on_primary</item>
        <item name="colorPrimaryContainer">@color/trashgo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/trashgo_on_primary_container</item>
        <item name="colorSecondary">@color/trashgo_primary</item>
        <item name="colorError">@color/trashgo_error</item>
        <item name="android:colorBackground">@color/trashgo_background</item>
        <item name="colorSurface">@color/trashgo_surface</item>
        <item name="colorOnSurface">@color/trashgo_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/trashgo_on_surface_variant</item>
        <item name="colorOutline">@color/trashgo_outline</item>
        <item name="colorOutlineVariant">@color/trashgo_divider</item>
        <!--  White status bar with dark icons; the app is a light design.  -->
        <item name="android:statusBarColor">@color/trashgo_surface</item>
        <item name="android:navigationBarColor">@color/trashgo_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="textInputStyle">@style/Widget.TrashGo.Field</item>
    </style>

    <style name="Theme.TrashGo.Splash" parent="Theme.TrashGo">
        <item name="android:windowBackground">@color/trashgo_surface</item>
    </style>

    <style name="TextAppearance.TrashGo.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/trashgo_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
    </style>

    <style name="TextAppearance.TrashGo.Headline" parent="TextAppearance.TrashGo.Display"/>

    <style name="TextAppearance.TrashGo.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/trashgo_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.TrashGo.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/trashgo_on_surface_variant</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.TrashGo.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/trashgo_on_surface_faint</item>
    </style>

    <style name="TextAppearance.TrashGo.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/trashgo_on_surface_faint</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.TrashGo.Stat" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/trashgo_on_surface</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Widget.TrashGo.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/trashgo_primary</item>
        <item name="android:textColor">@color/trashgo_on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.TrashGo.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/trashgo_primary_container</item>
        <item name="android:textColor">@color/trashgo_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.TrashGo.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/trashgo_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.TrashGo.Field" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/trashgo_surface_sunken</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/trashgo_on_surface_variant</item>
        <item name="android:textColorHint">@color/trashgo_on_surface_faint</item>
    </style>

    <style name="Widget.TrashGo.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/trashgo_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/trashgo_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.TrashGo.Sheet" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/trashgo_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
    </style>

    <style name="Widget.TrashGo.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/trashgo_divider</item>
    </style>

    <style name="Widget.TrashGo.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>
