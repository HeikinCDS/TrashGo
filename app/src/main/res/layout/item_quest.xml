<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quest_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/trashgo_divider"
    app:cardBackgroundColor="@color/trashgo_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/quest_tag"
                style="@style/TextAppearance.TrashGo.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/trashgo_primary"
                tools:text="OBJECTIVE OF THE DAY" />

            <TextView
                android:id="@+id/quest_reward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/trashgo_primary"
                tools:text="+100" />

        </LinearLayout>

        <TextView
            android:id="@+id/quest_title"
            style="@style/TextAppearance.TrashGo.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="18sp"
            tools:text="Scan any electronic waste item" />

        <ProgressBar
            android:id="@+id/quest_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:max="5"
            android:progress="2"
            android:progressTint="@color/trashgo_primary"
            android:progressBackgroundTint="@color/trashgo_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/quest_check"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/trashgo_primary"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/quest_progress_text"
                style="@style/TextAppearance.TrashGo.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                tools:text="Completed" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
